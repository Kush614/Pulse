{
  "name": "pulse-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run backend/tests",
    "sync:worldmonitor-data": "tsx scripts/generate-worldmonitor-data.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@insforge/sdk": "^1.2.2",
    "@memorilabs/memori": "^0.0.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.0",
    "openai": "^4.104.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
